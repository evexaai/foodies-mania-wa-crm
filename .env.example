# Copy this file to .env and fill in the real value. .env is never committed
# and must never be uploaded anywhere: it is the key to the database.

# The POOLED Neon connection string: the one with -pooler in the host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional. Set it and the order desk asks for this key once, then remembers
# it. Leave it unset and the desk is open to anyone who finds the address.
# STAFF_KEY=
